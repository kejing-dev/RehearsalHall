<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional permissions only: microphone (volume and pauses) and eye tracking (gaze). No network. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Eye gaze for "where you looked" (runtime permission; refused -> head direction). -->
    <uses-permission android:name="com.picovr.permission.EYE_TRACKING" />

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RehearsalHall"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.RehearsalHall">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DefaultStage: Full ("3": only virtual content), the hall opens around you (design container STAGE_FULL) -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="RehearsalHallStage" />
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="3" />
            <meta-data
                android:name="pico.spatial.stage.immersion"
                android:value="100" />
            <meta-data
                android:name="pico.spatial.stage.immersion_min"
                android:value="100" />
            <meta-data
                android:name="pico.spatial.stage.immersion_max"
                android:value="100" />
        </activity>

        <!-- Transparent helpers: the system file picker and the microphone permission dialog. -->
        <activity
            android:name=".platform.PickerActivity"
            android:exported="false"
            android:theme="@style/Theme.RehearsalHall" />
        <activity
            android:name=".platform.MicPermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.RehearsalHall" />
        <activity
            android:name=".platform.EyePermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.RehearsalHall" />

        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
